<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="Widgets"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todo se mueve en vivo · mantén presionado un widget para quitarlo"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

        <!-- Atajos: rutinas y lectura con cámara -->
        <LinearLayout
            android:id="@+id/w_cell_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/w_btn_morning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="14dp"
                android:tag="card"
                android:text="☀️
Buenos días"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_btn_night"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="14dp"
                android:tag="card"
                android:text="🌙
Buenas noches"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_btn_read"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="14dp"
                android:tag="card"
                android:text="📖
Leer con cámara"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_safety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="SEGURIDAD Y AYUDA"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">
                <TextView
                    android:id="@+id/w_sos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🆘
SOS"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_loc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="📍
Mi ubicación"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🏠
Llévame a casa"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">
                <TextView
                    android:id="@+id/w_medical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🩺
Datos médicos"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_breathe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🌬
Respirar"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_torch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🔦
Luz SOS"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">
                <TextView
                    android:id="@+id/w_siren"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🔊
Sirena"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_contacts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="👥
Contactos SOS"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="🔒
PIN cuidador"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Reloj + batería -->
        <LinearLayout
            android:id="@+id/w_row_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_cell_clock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:tag="card">

                <com.oasis.app.AnalogClockView
                    android:id="@+id/w_clock"
                    android:layout_width="130dp"
                    android:layout_height="130dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_cell_battery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:tag="card">

                <com.oasis.app.RingView
                    android:id="@+id/w_ring"
                    android:layout_width="130dp"
                    android:layout_height="130dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card"
            android:id="@+id/w_card_weather">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.oasis.app.WeatherAnimView
                    android:id="@+id/w_weather"
                    android:layout_width="110dp"
                    android:layout_height="96dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
            <TextView
                android:id="@+id/w_tv_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="--°"
                android:textSize="38sp" />
            <TextView
                android:id="@+id/w_tv_wsub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca para elegir tu ciudad"
                android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_net"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="RED EN VIVO"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
            <com.oasis.app.SparklineView
                android:id="@+id/w_spark"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
            <TextView
                android:id="@+id/w_tv_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="↓ 0 B/s"
                android:textSize="15sp"
                android:layout_weight="0" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            <TextView
                android:id="@+id/w_tv_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ 0 B/s"
                android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">
            <TextView
                android:id="@+id/w_tv_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="Mes"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <com.oasis.app.MonthView
                android:id="@+id/w_month"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.oasis.app.WaterView
                    android:id="@+id/w_water"
                    android:layout_width="90dp"
                    android:layout_height="110dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="AGUA DE HOY"
                android:textSize="12sp"
                        android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/w_tv_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="0 de 8 vasos"
                android:textSize="20sp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
            <TextView
                android:id="@+id/w_water_sub"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:tag="strong"
                android:text="−"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/w_water_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:tag="strong"
                android:text="+"
                android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="AHORA SUENA"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/w_np_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="Nada reproduciéndose"
                android:textSize="18sp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1" />
            <TextView
                android:id="@+id/w_np_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abre tu música y aparecerá aquí"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">
            <TextView
                android:id="@+id/w_np_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:tag="strong"
                android:text="⏮"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/w_np_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:tag="strong"
                android:text="⏯"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/w_np_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:tag="strong"
                android:text="⏭"
                android:textSize="20sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/w_np_perm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Para controlar la música, toca aquí y permite a OASIS leer notificaciones"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.oasis.app.ProgressRing
                    android:id="@+id/w_steps_ring"
                    android:layout_width="110dp"
                    android:layout_height="110dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

            <TextView
                android:id="@+id/w_tv_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="0 pasos"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/w_tv_steps_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta diaria · toca para cambiarla"
                android:textSize="13sp" />
                    <TextView
                        android:id="@+id/w_steps_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:tag="strong"
                        android:text="Activar el contador"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_habits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="HÁBITOS (toca para marcar hoy)"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/w_habits_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/w_habit_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="8dp"
                android:tag="strong"
                android:text="＋ Nuevo hábito"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_meds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="MEDICINAS"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/w_meds_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/w_meds_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Te aviso a la hora; si no confirmas en 30 minutos, le aviso a tu primer contacto SOS."
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/w_med_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="8dp"
                android:tag="strong"
                android:text="＋ Agregar medicina"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="LISTA DEL SÚPER"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/w_list_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/w_list_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Di: «agrega leche a la lista». Toca un artículo para quitarlo."
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/w_list_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="8dp"
                android:tag="strong"
                android:text="＋ Agregar artículo"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_bday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="CUMPLEAÑOS"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/w_bday_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/w_bday_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nada en los próximos 45 días (o falta el permiso de contactos)."
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:tag="strong"
                android:text="PRUEBA LA IA"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/w_ai_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escribe algo y toca Enviar. Aquí se ve lo que responde la IA y qué acción pensó hacer (no la ejecuta)."
                    android:textSize="14sp" />
            </ScrollView>

            <EditText
                android:id="@+id/w_ai_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Pregúntale algo…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">
                <TextView
                    android:id="@+id/w_ai_send"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="Enviar"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_ai_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="Probar conexión"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_ai_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:tag="card"
                    android:text="Limpiar"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cell_android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="WIDGETS DE ANDROID"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
            <LinearLayout
                android:id="@+id/w_hosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/w_add_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="strong"
                android:text="＋ Agregar un widget"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

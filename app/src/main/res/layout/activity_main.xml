<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Velo de color del tema sobre el fondo de pantalla del teléfono -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- Reloj -->
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tv_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Ajustes -->
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Ajustes"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Orbe + nombre + estado -->
        <LinearLayout
            android:id="@+id/center_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@id/pinned_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clock_container">

            <ImageView
                android:id="@+id/orb_view"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Toca para hablar"
                android:src="@drawable/orb_center" />

            <TextView
                android:id="@+id/greeting_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="OASIS"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="20dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Apps fijadas en inicio (mantén presionada una app en el cajón para fijarla) -->
        <FrameLayout
            android:id="@+id/pinned_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/swipe_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/tv_pinned_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Desliza hacia arriba, mantén presionada una app y fíjala aquí"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Indicador "desliza hacia arriba" -->
        <View
            android:id="@+id/swipe_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_handle"
            app:layout_constraintBottom_toTopOf="@id/dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Dock -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/dock_bg"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btn_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Llamar">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_call_gradient"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_phone" />

            <TextView
                android:id="@+id/lbl_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Llamar"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mensaje">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_message_gradient"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_message" />

            <TextView
                android:id="@+id/lbl_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Mensaje"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_contacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Contactos">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_contacts_gradient"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_contacts" />

            <TextView
                android:id="@+id/lbl_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Contactos"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Apps">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_apps_gradient"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_apps" />

            <TextView
                android:id="@+id/lbl_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Apps"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

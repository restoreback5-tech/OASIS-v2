<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Velo de color del tema sobre el fondo de pantalla del teléfono -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fondo animado (aurora / burbujas / estrellas) -->
    <com.oasis.app.LiveBackground
        android:id="@+id/live_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- Páginas deslizables: Inicio · Hoy · Mi teléfono -->
        <com.oasis.app.PageScroller
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/page_dots"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/pages"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <include
                    android:id="@+id/page_home"
                    layout="@layout/page_home"
                    android:layout_width="360dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/page_today"
                    layout="@layout/page_today"
                    android:layout_width="360dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/page_tools"
                    layout="@layout/page_tools"
                    android:layout_width="360dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/page_system"
                    layout="@layout/page_system"
                    android:layout_width="360dp"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </com.oasis.app.PageScroller>

        <!-- Ajustes (siempre visible) -->
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Ajustes"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Puntos de página -->
        <com.oasis.app.PageIndicator
            android:id="@+id/page_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@id/swipe_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Indicador "desliza hacia arriba" -->
        <View
            android:id="@+id/swipe_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_handle"
            app:layout_constraintBottom_toTopOf="@id/dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Dock (visible en todas las páginas) -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/dock_bg"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/btn_call"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Llamar"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_call_gradient"
                    android:elevation="4dp"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/lbl_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="strong"
                    android:text="Llamar"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Mensaje"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_message_gradient"
                    android:elevation="4dp"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_message" />

                <TextView
                    android:id="@+id/lbl_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="strong"
                    android:text="Mensaje"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_contacts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Contactos"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_contacts_gradient"
                    android:elevation="4dp"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_contacts" />

                <TextView
                    android:id="@+id/lbl_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="strong"
                    android:text="Contactos"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Apps"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_apps_gradient"
                    android:elevation="4dp"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_apps" />

                <TextView
                    android:id="@+id/lbl_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="strong"
                    android:text="Apps"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Icono de ajustes -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Ajustes"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#dadada"
        android:elevation="4dp" />

    <!-- Reloj -->
    <LinearLayout
        android:id="@+id/clock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="48sp"
            android:textColor="#1C1C1E"
            android:fontFamily="@font/sf_pro_display_bold" />
            
        <TextView
            android:id="@+id/tv_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#1C1C1E"
            android:fontFamily="@font/sf_pro_display_bold"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />
    </LinearLayout>

    <!-- Contenedor central -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:clipChildren="false">

        <!-- Orbe central (con tamaño extra para que no se corte) -->
        <ImageView
            android:id="@+id/orb_view"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/orb_center"
            android:layout_marginBottom="16dp" />

        <!-- Texto OASIS (Color corregido) -->
        <TextView
            android:id="@+id/greeting_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OASIS"
            android:textSize="24sp"
            android:textColor="#1C1C1E"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="32dp" />

        <!-- Fila 1: Llamar y Mensaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_call_gradient"
                android:stateListAnimator="@null"
                android:text="Llamar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_message_gradient"
                android:stateListAnimator="@null"
                android:text="Mensaje"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_message"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:iconPadding="8dp" />
        </LinearLayout>

        <!-- Fila 2: Contactos y Apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contacts"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_contacts_gradient"
                android:stateListAnimator="@null"
                android:text="Contactos"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_contacts"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apps"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_apps_gradient"
                android:stateListAnimator="@null"
                android:text="Apps"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_apps"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:iconPadding="8dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
